EXAMWATCH_ENV=development
EXAMWATCH_DATABASE_URL=sqlite:///./data/cloud-demo.sqlite3
EXAMWATCH_DATA_DIR=./data/cloud
EXAMWATCH_ALLOWED_ORIGINS=["http://localhost:3000"]
# Set explicitly for a local demo; never accepted when ENV=production.
EXAMWATCH_DEMO_TOKEN=change-this-local-demo-token
EXAMWATCH_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Production:
# EXAMWATCH_SUPABASE_URL=https://PROJECT.supabase.co
# EXAMWATCH_SUPABASE_KEY=server-only-secret
# EXAMWATCH_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER:5432/postgres
